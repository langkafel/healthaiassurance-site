---
import '../styles/global.css';
import '../styles/components.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Additional JSON-LD objects to render alongside the site-wide Organization schema. */
  structuredData?: Record<string, unknown>[];
  noindex?: boolean;
  /** Site-relative path to a 1200x630 image used for og:image / twitter:image. */
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  structuredData = [],
  noindex = false,
  ogImage = '/og/og-default.png',
  ogImageAlt = 'Health AI Assurance – AI Governance for Healthcare',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Health AI Assurance',
  url: Astro.site?.toString(),
  founder: {
    '@type': 'Person',
    name: 'Prof. Dr. med. Peter Langkafel',
  },
  email: 'info@peter-langkafel.de',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Mahlerstraße 23',
    postalCode: '13088',
    addressLocality: 'Berlin',
    addressCountry: 'DE',
  },
};

const schemas = [organizationSchema, ...structuredData];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title} · Health AI Assurance</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Health AI Assurance`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Health AI Assurance" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-900.woff2" as="font" type="font/woff2" crossorigin />

    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Zum Inhalt springen</a>
    <Nav currentPath={Astro.url.pathname} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
