    var current = 0;
    var answers = []; // {selected, correct}

    function esc(s) {
      return String(s).replace(/[&<>"]/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c];
      });
    }

    function renderSources(sources) {
      var label = sources.length > 1 ? "Quellen: " : "Quelle: ";
      return label + sources.map(esc).join("; ");
    }

    function renderBookRef(bookRef) {
      return "Buchverweis (vorläufig): " + esc(bookRef);
    }

    function startQuiz() {
      current = 0;
      answers = [];
      renderQuestion();
      switchScreen("screen-quiz");
    }
    function switchScreen(id) {
      document.querySelectorAll(".quickcheck .screen").forEach(function (s) { s.classList.remove("active"); });
      document.getElementById(id).classList.add("active");
      window.scrollTo(0, 0);
    }

    function renderQuestion() {
      var item = QUESTIONS[current];
      document.getElementById("qcat").textContent = item.category + " · " + item.title;
      document.getElementById("qtext").textContent = item.q;
      document.getElementById("qfeedback").innerHTML = "";
      document.getElementById("qnav").style.display = "none";

      var lettersArr = ["A", "B", "C", "D", "E"];
      var optsHtml = "";
      item.opts.forEach(function (opt, i) {
        optsHtml += '<button class="opt" data-idx="' + i + '" onclick="selectAnswer(' + i + ')">'
          + '<span class="letter">' + lettersArr[i] + '</span><span>' + opt + '</span></button>';
      });
      document.getElementById("qopts").innerHTML = optsHtml;

      updateProgress();
    }

    function updateProgress() {
      var pct = Math.round((current / QUESTIONS.length) * 100);
      document.getElementById("progressFill").style.width = pct + "%";
      document.getElementById("progressCount").textContent = "Frage " + (current + 1) + " / " + QUESTIONS.length;
      var correctCount = answers.filter(function (a) { return a.correct; }).length;
      document.getElementById("scoreLive").textContent = correctCount + " richtig";
    }

    function selectAnswer(idx) {
      var item = QUESTIONS[current];
      var isCorrect = (idx === item.correct);
      answers[current] = { selected: idx, correct: isCorrect };

      var buttons = document.querySelectorAll("#qopts .opt");
      buttons.forEach(function (btn, i) {
        btn.disabled = true;
        if (i === item.correct) btn.classList.add("correct");
        else if (i === idx) btn.classList.add("wrong");
        else btn.classList.add("faded");
      });

      var fb = document.getElementById("qfeedback");
      var nudges = [
        "Genau dieser Punkt wird im entstehenden Buch vertieft ausgeführt.",
        "Im Buch finden Sie dazu die vollständige Herleitung.",
        "Das Buch geht hier deutlich tiefer als diese Kurzantwort.",
        "Für die Praxis liefert das Buch dazu ein konkretes Werkzeug."
      ];
      var nudgeHtml = isCorrect ? "" :
        '<div class="buy-nudge">' + nudges[current % nudges.length]
        + ' <a href="/buch">Zum Buch →</a></div>';
      fb.innerHTML = '<div class="feedback ' + (isCorrect ? 'right' : 'wrong') + '">'
        + '<div class="fl">' + (isCorrect ? '✓ Richtig' : '✕ Nicht ganz') + '</div>'
        + '<p>' + item.expl + '</p>'
        + '<span class="book-ref">' + renderBookRef(item.bookRef) + '</span>'
        + '<span class="src">' + renderSources(item.sources) + '</span>'
        + nudgeHtml
        + '</div>';

      document.getElementById("qnav").style.display = "flex";
      document.getElementById("btnNext").textContent = (current === QUESTIONS.length - 1) ? "Auswertung ansehen" : "Nächste Frage";
      updateProgress();
    }

    function nextQuestion() {
      if (current < QUESTIONS.length - 1) {
        current++;
        renderQuestion();
      } else {
        showResult();
      }
    }

    function scoreVerdict(pct) {
      if (pct >= 83) return { cls: "green", label: "Assurance-Profi" };
      if (pct >= 50) return { cls: "amber", label: "Solide Grundlage" };
      return { cls: "red", label: "Auffrischung empfohlen" };
    }

    function renderCategoryBreakdown() {
      var stats = {};
      CATEGORIES.forEach(function (c) { stats[c] = { correct: 0, total: 0 }; });
      QUESTIONS.forEach(function (item, i) {
        var a = answers[i];
        stats[item.category].total++;
        if (a && a.correct) stats[item.category].correct++;
      });

      var ratios = CATEGORIES.map(function (c) {
        var s = stats[c];
        return { cat: c, correct: s.correct, total: s.total, pct: s.total ? Math.round((100 * s.correct) / s.total) : 0 };
      });

      var pcts = ratios.map(function (r) { return r.pct; });
      var maxPct = Math.max.apply(null, pcts);
      var minPct = Math.min.apply(null, pcts);

      var insightHtml;
      if (maxPct === minPct) {
        insightHtml = "Sie liegen in allen Themenblöcken auf einem vergleichbaren Niveau.";
      } else {
        var strongest = ratios.filter(function (r) { return r.pct === maxPct; })[0];
        var weakest = ratios.filter(function (r) { return r.pct === minPct; })[0];
        insightHtml = "Ihr stärkster Bereich: <strong>" + esc(strongest.cat) + "</strong> — Nachholbedarf sehen wir bei: <strong>" + esc(weakest.cat) + "</strong>.";
      }
      document.getElementById("catInsight").innerHTML = insightHtml;

      document.getElementById("categoryBreakdown").innerHTML = ratios.map(function (r) {
        return '<div class="cat-row">'
          + '<div class="cat-row-top"><span class="cat-name">' + esc(r.cat) + '</span><span class="cat-frac">' + r.correct + '/' + r.total + '</span></div>'
          + '<div class="cat-track"><div class="cat-fill" style="width:' + r.pct + '%"></div></div>'
          + '</div>';
      }).join('');
    }

    function showResult() {
      var correctCount = answers.filter(function (a) { return a.correct; }).length;
      var pct = Math.round((correctCount / QUESTIONS.length) * 100);
      var v = scoreVerdict(pct);

      document.getElementById("scorePct").textContent = correctCount;
      document.getElementById("scoreCircle").style.borderColor =
        v.cls === "green" ? "var(--green)" : v.cls === "amber" ? "var(--amber)" : "var(--red)";
      var badge = document.getElementById("verdictBadge");
      badge.textContent = v.label;
      badge.className = "verdict-badge c-" + v.cls;

      var texts = {
        green: "Sie kennen die Fallstricke gut – von den EU-AI-Act-Fristen bis zum Incident Management. Für die verbleibenden Lücken lohnt ein gezielter Blick in die unten verlinkten Kapitel.",
        amber: "Eine solide Grundlage mit erkennbaren Lücken bei einzelnen Themen. Die Kapitelverweise unten zeigen genau, wo sich die Vertiefung am meisten lohnt.",
        red: "Ein guter Anlass, tiefer einzusteigen: Die unten verlinkten Kapitel bauen genau die Punkte aus, die hier noch offen waren."
      };
      document.getElementById("verdictText").textContent = texts[v.cls];
      document.getElementById("resultMeta").textContent =
        correctCount + " von " + QUESTIONS.length + " Fragen richtig · " + new Date().toLocaleDateString("de-DE", { day: "numeric", month: "long", year: "numeric" });

      renderCategoryBreakdown();

      var html = "";
      QUESTIONS.forEach(function (item, i) {
        var a = answers[i];
        var ok = a && a.correct;
        html += '<div class="rev-item ' + (ok ? 'ok' : 'no') + '">'
          + '<div class="rev-top"><span class="rev-icon">' + (ok ? '✓' : '✕') + '</span><span class="rev-q">' + item.q + '</span></div>'
          + '<p>' + item.expl + '</p>'
          + '<span class="book-ref">' + renderBookRef(item.bookRef) + '</span>'
          + '<span class="src">' + renderSources(item.sources) + '</span>'
          + '</div>';
      });
      document.getElementById("reviewList").innerHTML = html;

      switchScreen("screen-result");
    }

    function restart() {
      current = 0;
      answers = [];
      switchScreen("screen-intro");
    }

    window.startQuiz = startQuiz;
    window.nextQuestion = nextQuestion;
    window.selectAnswer = selectAnswer;
    window.restart = restart;
  })();
</script>
