---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="footer-name">Health AI Assurance</p>
      <p class="footer-by">Prof. Dr. med. Peter Langkafel, MBA</p>
    </div>

    <nav class="footer-nav" aria-label="Rechtliches">
      <a href="/impressum">Impressum</a>
      <a href="/datenschutz">Datenschutz</a>
      <a href="mailto:info@peter-langkafel.de">Kontakt</a>
    </nav>

    <p class="footer-copy">&copy; {year} Peter Langkafel. Alle Rechte vorbehalten.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-card-alt);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: 32px;
  }

  .footer-name {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 4px;
  }

  .footer-by,
  .footer-copy {
    color: var(--color-text-footer);
    font-size: 0.85rem;
    margin: 0;
  }

  .footer-nav {
    display: flex;
    gap: 20px;
  }

  .footer-nav a {
    color: var(--color-text-footer);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--color-accent);
  }
</style>
