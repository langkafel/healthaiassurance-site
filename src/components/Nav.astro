---
import { Icon } from 'astro-icon/components';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: '/loesung', label: 'Lösung' },
  { href: '/incident-atlas', label: 'Incident Atlas' },
  { href: '/solutions-atlas', label: 'Solutions Atlas' },
  { href: '/quick-check', label: 'Quick Check' },
  { href: '/buch', label: 'Buch' },
];

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-nav">
  <div class="container site-nav-inner">
    <a href="/" class="brand">
      Health <span>AI</span> Assurance
    </a>

    <button
      class="nav-toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Menü öffnen"
    >
      <Icon name="ph:list" aria-hidden="true" />
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Hauptnavigation">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        class="login-link"
        href="/kontakt"
        aria-current={isActive('/kontakt') ? 'page' : undefined}
      >
        <Icon name="ph:envelope-simple" aria-hidden="true" />
        Kontakt
      </a>
      <a class="login-link" href="https://app.healthaiassurance.de" target="_blank" rel="noopener noreferrer">
        <Icon name="ph:sign-in" aria-hidden="true" />
        Login für Bestandskunden
      </a>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding-top: env(safe-area-inset-top);
  }

  .site-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 16px;
  }

  .brand {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.1rem;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .brand span {
    color: var(--color-accent);
  }

  .nav-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    color: var(--color-text);
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .nav-toggle :global(svg) {
    width: 24px;
    height: 24px;
  }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .primary-nav ul {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .primary-nav a {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    text-decoration: none;
    padding-block: 4px;
    border-bottom: 2px solid transparent;
  }

  .primary-nav a:hover,
  .primary-nav a[aria-current='page'] {
    color: var(--color-text);
    border-bottom-color: var(--color-accent);
  }

  .login-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .login-link :global(svg) {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 860px) {
    .nav-toggle {
      display: inline-flex;
    }

    .primary-nav {
      position: fixed;
      inset: 0 0 0 auto;
      top: 0;
      height: 100vh;
      width: min(320px, 85vw);
      background: var(--color-card-alt);
      border-left: 1px solid var(--color-border);
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 32px;
      padding: 96px 28px 28px;
      transform: translateX(100%);
      transition: transform 0.2s ease;
      padding-top: calc(96px + env(safe-area-inset-top));
      padding-bottom: calc(28px + env(safe-area-inset-bottom));
    }

    .primary-nav.is-open {
      transform: translateX(0);
    }

    .primary-nav ul {
      flex-direction: column;
      gap: 20px;
    }

    .primary-nav a {
      font-size: 1.05rem;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
    toggle.setAttribute('aria-label', isOpen ? 'Menü schließen' : 'Menü öffnen');
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Menü öffnen');
    });
  });
</script>
