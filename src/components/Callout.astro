---
import { Icon } from 'astro-icon/components';

interface Props {
  icon?: string;
}

const { icon = 'ph:info' } = Astro.props;
---

<div class="callout" role="note">
  <span class="callout-icon"><Icon name={icon} aria-hidden="true" width="22" height="22" /></span>
  <div>
    <slot />
  </div>
</div>
