---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Incident Atlas"
  description="Health AI Incident Atlas — Inhalt folgt in Kürze."
  noindex
>
  <section class="section placeholder">
    <div class="container">
      <p class="eyebrow">In Vorbereitung</p>
      <h1>Health AI Incident Atlas</h1>
      <p>Inhalt folgt in Kürze.</p>
      <a class="btn btn-primary" href="/">Zurück zur Startseite</a>
    </div>
  </section>
</BaseLayout>

<style>
  .placeholder {
    text-align: center;
    padding-block: clamp(96px, 16vw, 180px);
  }

  .placeholder p {
    max-width: 50ch;
    margin-inline: auto;
    margin-bottom: 2em;
  }
</style>
