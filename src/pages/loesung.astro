---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import ContactCta from '../components/ContactCta.astro';
import { Icon } from 'astro-icon/components';
import { personSchema } from '../lib/schema';

// Manuell pflegen: nur ändern, wenn der Regulatorik-Abschnitt inhaltlich überprüft wurde (nicht bei jedem Deploy).
const stichtag = '23. September 2026';

const processSteps = [
  {
    n: '01',
    title: 'Erfassen',
    text: 'Alle im Einsatz befindlichen und geplanten KI-Systeme werden strukturiert erfasst: Einsatzbereich, Datengrundlage, Hersteller, Schnittstellen und betroffene Prozesse. Ergebnis ist ein dokumentiertes KI-Inventar als verlässliche Ausgangsbasis.',
  },
  {
    n: '02',
    title: 'Bewerten',
    text: 'Für jedes System werden regulatorische Anforderungen, Risikoklasse und vorhandene Nachweise geprüft. Eine strukturierte Gap-Analyse zeigt, wo Dokumentation, Kontrollen oder Freigaben fehlen.',
  },
  {
    n: '03',
    title: 'Handeln',
    text: 'Aus der Bewertung werden priorisierte Maßnahmen abgeleitet und klaren Verantwortlichen zugewiesen — inklusive Fristen und Freigabeprozessen, etwa im Rahmen eines Procurement Gates.',
  },
  {
    n: '04',
    title: 'Entscheiden',
    text: 'Auf Basis der Bewertung wird eine begründete Entscheidung getroffen — Freigabe, Nachbesserung oder Stopp. Kriterien und Verantwortliche stehen vorab fest, damit die Entscheidung nachvollziehbar bleibt, nicht beliebig.',
  },
  {
    n: '05',
    title: 'Überwachen',
    text: 'Status, Änderungen an Systemen und gemeldete Vorfälle werden laufend nachverfolgt. Management-Reporting macht den Fortschritt jederzeit nachvollziehbar.',
  },
];

const modules = [
  {
    icon: 'ph:shield',
    title: 'Assurance-Kern & Glossar',
    text: '285 Kriterien in 15 Dimensionen — EU AI Act, MDR/IVDR, ISO/IEC 42001, DSGVO, B3S, NIS2.',
  },
  {
    icon: 'ph:sliders-horizontal',
    title: 'Technische Eignung',
    text: 'Ist das Produkt technisch transparent, nachvollziehbar und geeignet?',
  },
  {
    icon: 'ph:buildings',
    title: 'Betriebsbereitschaft',
    text: 'Ist die Organisation bereit für Einführung und dauerhaften Betrieb?',
  },
  {
    icon: 'ph:currency-eur',
    title: 'Wirtschaftlichkeit & TCO',
    text: 'Kosten- und Nutzenpositionen, Szenarien, Break-even — als echte Datensätze.',
  },
  {
    icon: 'ph:heartbeat',
    title: 'Versorgungsnutzen',
    text: 'Nutzenhypothesen mit Baseline, Zielwert, Messgröße und Verantwortlichem.',
  },
  {
    icon: 'ph:handshake',
    title: 'Vendor Assurance Portal',
    text: 'Strukturierter, versionierter Austausch mit Anbietern statt E-Mail-Chaos.',
  },
];

const perspectives = [
  { icon: 'ph:user-light', title: 'Geschäftsführung', quote: '„Ist das sicher? Lohnt sich das?“' },
  { icon: 'ph:gear-six-light', title: 'CIO / IT-Leitung', quote: '„Kann ich das integrieren?“' },
  { icon: 'ph:lock-light', title: 'Datenschutz', quote: '„Wo liegen unsere Daten?“' },
  { icon: 'ph:heartbeat-light', title: 'CMIO / Medizin / QM', quote: '„Ist das medizinisch vertretbar?“' },
  { icon: 'ph:shopping-cart-light', title: 'Einkauf', quote: '„Welches Risiko gehe ich ein?“' },
  { icon: 'ph:handshake-light', title: 'Hersteller', quote: '„Wie überzeuge ich Kliniken schneller?“' },
];

const comparison = [
  ['Nachweise verstreut in E-Mails & Excel', 'Zentrale, versionierte Vendor-Akte'],
  ['Prüftiefe von Person zu Person unterschiedlich', 'Einheitlicher Kriterienkatalog in 15 Dimensionen'],
  ['Kosten & Nutzen nicht strukturiert bewertet', 'TCO & Nutzenhypothesen als echte Datensätze'],
  ['Entscheidung schwer zu begründen', 'Gremienfähiger Bericht mit Entscheidungsreife'],
  ['Keine Wiedervorlage nach Go-live', 'Lifecycle-Sicht: Re-Assessments & Reviews'],
];

const regulatoryRows = [
  {
    topic: 'Art. 50 Transparenzpflichten',
    detail: 'Chatbot-Kennzeichnung, Deepfake-Labeling',
    deadline: 'Gilt bereits seit 2. August 2026',
  },
  {
    topic: 'Hochrisiko-KI, eigenständige Systeme',
    detail: 'Nach Anhang III',
    deadline: 'Spätestens 2. Dezember 2027',
  },
  {
    topic: 'Hochrisiko-KI, eingebettet in regulierte Produkte',
    detail: 'Nach Anhang I, u. a. Medizinprodukte',
    deadline: 'Spätestens 2. August 2028',
  },
];

const badges = ['MDR/IVDR', 'ISO/IEC 42001', 'DSGVO', 'BSI B3S/KRITIS', 'NIS2'];
---

<BaseLayout
  title="Lösung"
  description="Health AI Assurance: ein strukturiertes Verfahren für nachweisbare KI-Governance im Gesundheitswesen — für SaMD-Hersteller und Kliniken."
  structuredData={[personSchema(Astro.site)]}
>
  <section class="section hero-solution">
    <div class="container">
      <p class="eyebrow">Health AI Assurance</p>
      <h1>Ein wiederholbarer Prozess für nachweisbare KI-Governance</h1>
      <p class="lead">
        Health AI Assurance ist ein strukturiertes Verfahren für nachweisbare KI-Governance im
        Gesundheitswesen — für SaMD-Hersteller ebenso wie für Kliniken. Kein einmaliges Beratungsgespräch,
        sondern ein wiederholbarer Prozess, der Verantwortlichkeiten schafft und Nachweise liefert.
      </p>
      <a class="login-badge" href="/login">
        <Icon name="ph:sign-in" aria-hidden="true" />
        Login für Bestandskunden
      </a>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>Der Prozess</h2>
      <div class="process">
        {
          processSteps.map((step) => (
            <div class="process-step">
              <span class="step-number">{step.n}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section perspectives-section">
    <div class="container">
      <p class="eyebrow">Zielgruppen</p>
      <h2>Es gibt nicht „den“ Nutzer</h2>
      <p class="section-intro">
        Sechs Perspektiven, sechs Kernfragen — Health AI Assurance beantwortet sie alle aus derselben Datengrundlage.
      </p>
      <div class="module-grid perspective-grid">
        {
          perspectives.map((p) => (
            <div class="module-card">
              <span class="module-icon">
                <Icon name={p.icon} aria-hidden="true" width="24" height="24" />
              </span>
              <div class="module-body">
                <h3>{p.title}</h3>
                <p class="persp-quote">{p.quote}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Die sechs Module</h2>
      <blockquote class="pull-quote">
        Jede Klinik führt ein Medizinprodukte-Register. Warum nicht auch ein KI-Register?
      </blockquote>
      <div class="module-grid">
        {
          modules.map((mod) => (
            <div class="module-card">
              <span class="module-icon">
                <Icon name={mod.icon} aria-hidden="true" width="24" height="24" />
              </span>
              <div class="module-body">
                <h3>{mod.title}</h3>
                <p>{mod.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section sticker-section">
    <div class="container">
      <a class="ref-sticker" href="mailto:info@peter-langkafel.de">
        Werden Sie einer unserer ersten Referenzkunden — jetzt melden!
      </a>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <Card class="boundary-card">
        <p>
          <strong>Assurance bedeutet bei Health AI Assurance:</strong> systematische Überprüfung, dokumentierte
          Verantwortlichkeiten und nachvollziehbare Nachweise. Keine pauschale Sicherheitsgarantie und keine
          gesetzliche Konformitätsbewertung oder Zertifizierung.
        </p>
      </Card>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Nutzen</p>
      <h2>Der Unterschied im Klinikalltag</h2>
      <div class="compare">
        <div class="compare-head" aria-hidden="true">
          <span class="compare-title compare-title-without">Ohne Health AI Assurance</span>
          <span></span>
          <span class="compare-title compare-title-with">Mit Health AI Assurance</span>
        </div>
        {
          comparison.map(([without, withHaa]) => (
            <div class="compare-row">
              <p class="compare-cell compare-without">
                <Icon name="ph:x-circle-light" aria-hidden="true" width="24" height="24" />
                <span>
                  <span class="cell-label">Ohne Health AI Assurance: </span>
                  {without}
                </span>
              </p>
              <span class="compare-arrow" aria-hidden="true">
                <Icon name="ph:arrow-right-light" width="28" height="28" />
              </span>
              <p class="compare-cell compare-with">
                <Icon name="ph:check-circle-light" aria-hidden="true" width="24" height="24" />
                <span>
                  <span class="cell-label">Mit Health AI Assurance: </span>
                  {withHaa}
                </span>
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Regulatorischer Rahmen</h2>
      <p class="stand">Stand: {stichtag}</p>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Anforderung</th>
              <th scope="col">Details</th>
              <th scope="col">Frist</th>
            </tr>
          </thead>
          <tbody>
            {
              regulatoryRows.map((row) => (
                <tr>
                  <td>{row.topic}</td>
                  <td>{row.detail}</td>
                  <td>{row.deadline}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="badge-row standards-row">
        {badges.map((badge) => <Badge>{badge}</Badge>)}
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  .lead {
    max-width: 68ch;
    font-size: 1.1rem;
    margin-bottom: 1.75em;
  }

  .login-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .login-badge :global(svg) {
    width: 18px;
    height: 18px;
  }

  .pull-quote {
    margin: 0 0 32px;
    max-width: 56ch;
    padding-left: 20px;
    border-left: 2px solid var(--color-border);
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1.1rem, 0.95rem + 0.8vw, 1.4rem);
    color: var(--color-text);
    line-height: 1.4;
  }

  .module-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .module-card {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 24px;
  }

  .module-icon {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background: var(--color-card-alt);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .module-body h3 {
    font-size: 1.05rem;
    margin-bottom: 6px;
  }

  .module-body p {
    margin: 0;
    font-size: 0.92rem;
  }

  .perspectives-section {
    padding-bottom: 0;
  }

  .section-intro {
    max-width: 62ch;
    margin-bottom: 32px;
  }

  .perspective-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .persp-quote {
    font-style: italic;
    color: var(--color-text-muted);
  }

  .compare {
    display: grid;
    gap: 16px;
    margin-top: 32px;
  }

  .compare-head,
  .compare-row {
    display: grid;
    grid-template-columns: 1fr 48px 1fr;
    align-items: stretch;
    gap: 12px;
  }

  .compare-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .compare-title::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    margin-right: 8px;
  }

  .compare-title-without::before {
    background: var(--color-red);
  }

  .compare-title-with::before {
    background: var(--color-green);
  }

  .compare-cell {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin: 0;
    padding: 16px 18px;
    border: 1px solid;
    border-radius: var(--radius-card);
    color: var(--color-text);
    line-height: 1.5;
  }

  .compare-cell :global(svg) {
    flex: none;
    margin-top: 1px;
  }

  .compare-without {
    border-color: var(--color-red);
    background: rgba(239, 68, 68, 0.1);
  }

  .compare-without :global(svg) {
    color: var(--color-red);
  }

  .compare-with {
    border-color: var(--color-green);
    background: rgba(16, 185, 129, 0.1);
  }

  .compare-with :global(svg) {
    color: var(--color-green);
  }

  .compare-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
  }

  .cell-label {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .sticker-section {
    padding-block: 0 clamp(48px, 6vw, 96px);
    text-align: center;
  }

  .ref-sticker {
    display: inline-block;
    background: var(--color-amber);
    color: var(--color-bg);
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(1rem, 0.85rem + 0.6vw, 1.2rem);
    padding: 20px 36px;
    border-radius: 20px;
    transform: rotate(-6deg);
    text-decoration: none;
    max-width: 46ch;
  }

  .ref-sticker:hover {
    transform: rotate(-3deg);
  }

  @media (max-width: 900px) {
    .perspective-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .module-grid,
    .perspective-grid {
      grid-template-columns: 1fr;
    }

    .compare {
      gap: 28px;
    }

    .compare-head {
      display: none;
    }

    .compare-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .compare-arrow {
      transform: rotate(90deg);
      height: 28px;
    }

    .cell-label {
      position: static;
      display: block;
      width: auto;
      height: auto;
      margin: 0 0 2px;
      overflow: visible;
      clip: auto;
      white-space: normal;
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text-muted);
    }
  }

  .boundary-card p {
    margin: 0;
    color: var(--color-text);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .stand {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25em;
  }

  .standards-row {
    margin-top: 24px;
  }
</style>
